<section class="card card-body">
    <h2>{{ __('Webhook credentials', 'uxconnector') }} #{{ job_id|e }}</h2>
    {% if rotated %}
        <p class="alert alert-warning">
            {{ __('The old signing secret is no longer valid. Update the sender with the new secret.', 'uxconnector') }}
        </p>
    {% endif %}
    {% if bearer %}
        <p>{{ __('Bearer header', 'uxconnector') }}</p>
        <p><code>X-UXConnector-Webhook-Key: {{ credential|e }}</code></p>
    {% else %}
        <p>{{ __('Signing secret', 'uxconnector') }}</p>
        <p><code>{{ credential|e }}</code></p>
    {% endif %}
    <div><a class="btn btn-outline-secondary" href="{{ return_url|e }}">{{ __('Back to connection', 'uxconnector') }}</a></div>
</section>
