<div class="uxconnector-connections">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">{{ __('Connections', 'uxconnector') }}</h2>
            <p class="text-muted mb-0">{{ __('Configure each external system once, then manage its interactions from the connection.', 'uxconnector') }}</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            {% if can_create %}<a href="connection.form.php" class="btn btn-primary"><i class="ti ti-plus"></i> {{ __('New connection', 'uxconnector') }}</a>{% endif %}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="text-muted me-2"><i class="ti ti-route"></i> {{ __('UXConnector', 'uxconnector') }}</span>
            <a href="connections.php" class="btn btn-sm btn-primary"><i class="ti ti-plug-connected"></i> {{ __('Connections', 'uxconnector') }}</a>
            {% if can_read_jobs %}<a href="catalog.php" class="btn btn-sm btn-outline-secondary"><i class="ti ti-layout-grid"></i> {{ __('Connector catalog', 'uxconnector') }}</a><a href="syncjob.php" class="btn btn-sm btn-outline-secondary"><i class="ti ti-arrows-exchange"></i> {{ __('Interactions', 'uxconnector') }}</a>{% endif %}
        </div>
    </div>

    {% if connections is empty %}
        <div class="alert alert-info">{{ __('No connection configured yet.', 'uxconnector') }}</div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table table-hover card-table align-middle">
                    <thead><tr><th>{{ __('Connection', 'uxconnector') }}</th><th>{{ __('Type', 'uxconnector') }}</th><th>{{ __('Endpoint', 'uxconnector') }}</th><th>{{ __('Status', 'uxconnector') }}</th><th>{{ __('Actions', 'uxconnector') }}</th></tr></thead>
                    <tbody>
                    {% for connection in connections %}
                        <tr>
                            <td><a href="connection.php?id={{ connection.id }}"><strong>{{ connection.name }}</strong></a></td>
                            <td>{{ connector_names[connection.connectorId] ?? connection.connectorId }}</td>
                            <td><code>{{ connection.endpoint }}</code></td>
                            <td><span class="badge {% if connection.status == 'active' %}bg-success{% elseif connection.status == 'error' %}bg-danger{% elseif connection.status == 'disabled' %}bg-secondary{% else %}bg-info{% endif %}">{{ connection.statusLabel }}</span></td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    <a class="btn btn-sm btn-outline-primary" href="connection.php?id={{ connection.id }}"><i class="ti ti-settings"></i> {{ __('Manage', 'uxconnector') }}</a>
                                    {% if can_update %}
                                        <a class="btn btn-sm btn-outline-secondary" href="connection.form.php?id={{ connection.id }}"><i class="ti ti-pencil"></i> {{ __('Edit', 'uxconnector') }}</a>
                                    {% endif %}
                                    {% if can_read_jobs %}
                                        <a class="btn btn-sm btn-outline-primary" href="connection.php?id={{ connection.id }}#interactions"><i class="ti ti-arrows-exchange"></i> {{ __('Interactions', 'uxconnector') }}</a>
                                    {% endif %}
                                    {% if can_update %}
                                        <form method="post" action="connection.php" class="d-inline">
                                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="id" value="{{ connection.id }}">
                                            <input type="hidden" name="return_to" value="connections">
                                            <button class="btn btn-sm btn-outline-secondary" name="test" value="1">{{ __('Test', 'uxconnector') }}</button>
                                        </form>
                                        {% if connection.status == 'testing' %}
                                            <form method="post" action="connection.php" class="d-inline">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                                <input type="hidden" name="id" value="{{ connection.id }}">
                                                <input type="hidden" name="return_to" value="connections">
                                                <button class="btn btn-sm btn-success" name="activate" value="1">{{ __('Activate', 'uxconnector') }}</button>
                                            </form>
                                        {% elseif connection.status == 'active' %}
                                            <form method="post" action="connection.php" class="d-inline">
                                                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                                <input type="hidden" name="id" value="{{ connection.id }}">
                                                <input type="hidden" name="return_to" value="connections">
                                                <button class="btn btn-sm btn-outline-warning" name="disable" value="1">{{ __('Disable', 'uxconnector') }}</button>
                                            </form>
                                        {% endif %}
                                    {% endif %}
                                    {% if can_delete %}
                                        <form method="post" action="connection.php" class="d-inline">
                                            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
                                            <input type="hidden" name="id" value="{{ connection.id }}">
                                            <button class="btn btn-sm btn-outline-danger" name="delete" value="1" onclick="return confirm('{{ __('Permanently delete this connection?', 'uxconnector')|e('js') }}')">{{ __('Delete', 'uxconnector') }}</button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
