{% autoescape 'html' %}
    <div class="container-fluid p-3">
        <a class="btn btn-outline-secondary mb-3" href="connection.php?id={{ connection_id }}">&larr; Back to connection</a>
        <h2>GLPI REST v1 - Location Fields diagnostic (Telecom profile)</h2>
        <p>Read-only discovery using <code>/listSearchOptions/Location</code>. No records, secrets or dropdown option values are displayed.</p>

        {% if report is null %}
            <div class="alert alert-danger">Could not retrieve source search options. Verify the connection test and PHP/GLPI logs. No data was modified.</div>
        {% else %}
            <p><strong>{{ report.total }}</strong> search options examined.
                {{ report.resolved|length }} mapped, {{ report.missing|length }} unmatched, {{ report.ambiguous|length }} ambiguous.</p>
            <table class="table table-striped table-sm">
                <thead><tr><th>Logical source field</th><th>Search option ID</th><th>Result</th></tr></thead>
                <tbody>
                    {% for field in fields %}
                        <tr><td><code>{{ field.name }}</code></td><td>{{ field.option }}</td><td>{{ field.status }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>

            <h3>Fields options exposed by the API</h3>
            <p>Only whitelisted schema metadata is listed (up to 250 Fields options). If a dropdown is absent here, recreating it in the source without checking API exposure will not fix the mapping.</p>
            <table class="table table-striped table-sm">
                <thead><tr><th>ID</th><th>Label</th><th>Group</th><th>Table</th><th>Field</th></tr></thead>
                <tbody>
                    {% for candidate in report.candidates %}
                        <tr>
                            <td>{{ candidate.id }}</td>
                            <td>{{ candidate.name }}</td>
                            <td>{{ candidate.group }}</td>
                            <td><code>{{ candidate.table }}</code></td>
                            <td><code>{{ candidate.field }}</code></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endautoescape %}
