{% autoescape 'html' %}
    <div class="firstbloc">
        <form name="form" method="post" action="{{ form_url }}">
            <input type="hidden" name="id" value="{{ profile_id }}">
            {% if can_edit %}
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            {% endif %}
            {# Output of GLPI's native checkbox_matrix Twig component. #}
            {{ rights_matrix|raw }}
            {% if can_edit %}
                <div class="center mt-3">
                    <button type="submit" class="btn btn-primary" name="update" value="1">
                        <i class="ti ti-device-floppy"></i>
                        <span>{{ _x('button', 'Save') }}</span>
                    </button>
                </div>
            {% endif %}
        </form>
    </div>
{% endautoescape %}
