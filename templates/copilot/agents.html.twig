<div class="uxconnector-copilot-agents">
    <div class="mb-3">
        <h2>{{ __('AI Agents / Copilot Gateway', 'uxconnector') }}</h2>
        <p class="text-muted">{{ __('Create inbound API clients for Microsoft Copilot Studio. For the GLPI instance hosting UXConnector, Local GLPI is recommended: it avoids a self-HTTP OAuth connection and keeps UXConnector read-only.', 'uxconnector') }}</p>
    </div>

    {% if generated_key %}
        <div class="alert alert-warning">
            <strong>{{ __('Copy this API key now. It will not be displayed again.', 'uxconnector') }}</strong>
            <div class="mt-2"><code style="user-select:all">{{ generated_key }}</code></div>
        </div>
    {% endif %}

    {% if can_create %}
    <div class="card mb-4"><div class="card-header"><strong>{{ __('Create an AI agent client', 'uxconnector') }}</strong></div><div class="card-body">
        <form method="post" action="copilot-agents.php">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">{{ __('Name', 'uxconnector') }}</label><input name="name" class="form-control" required maxlength="128" value="Copilot Studio"></div>
                <div class="col-md-4"><label class="form-label">{{ __('Provider', 'uxconnector') }}</label>
                    <select name="provider_type" class="form-select" id="uxc-provider-type" onchange="document.getElementById('uxc-remote-connection').style.display=this.value==='glpi_hl_api'?'block':'none'">
                        <option value="local_glpi">{{ __('Local GLPI (recommended)', 'uxconnector') }}</option>
                        <option value="glpi_hl_api">{{ __('Remote GLPI 11 High-Level API', 'uxconnector') }}</option>
                    </select>
                </div>
                <div class="col-md-4" id="uxc-remote-connection" style="display:none"><label class="form-label">{{ __('UXConnector connection', 'uxconnector') }}</label>
                    <select name="auth_config_reference" class="form-select"><option value="0">-</option>{% for id,label in connections %}<option value="{{ id }}">{{ label }}</option>{% endfor %}</select>
                </div>
            </div>
            <div class="mt-3"><button type="submit" name="create_agent" value="1" class="btn btn-primary"><i class="ti ti-robot"></i> {{ __('Create agent and API key', 'uxconnector') }}</button></div>
        </form>
    </div></div>
    {% endif %}

    <div class="card"><div class="card-header"><strong>{{ __('Configured agents', 'uxconnector') }}</strong></div><div class="table-responsive"><table class="table table-hover mb-0">
        <thead><tr><th>ID</th><th>{{ __('Name', 'uxconnector') }}</th><th>{{ __('Provider', 'uxconnector') }}</th><th>{{ __('Status', 'uxconnector') }}</th><th>{{ __('Created', 'uxconnector') }}</th><th>{{ __('Actions', 'uxconnector') }}</th></tr></thead>
        <tbody>
        {% for client in clients %}
            <tr>
                <td>#{{ client.id }}</td><td>{{ client.name }}</td>
                <td>{% if client.provider_type|default('glpi_hl_api') == 'local_glpi' %}Local GLPI{% else %}GLPI HL API{% if client.auth_config_reference %} · connection #{{ client.auth_config_reference }}{% endif %}{% endif %}</td>
                <td>{% if client.is_active %}<span class="badge bg-success">{{ __('Active', 'uxconnector') }}</span>{% else %}<span class="badge bg-secondary">{{ __('Disabled', 'uxconnector') }}</span>{% endif %}</td>
                <td>{{ client.date_creation }}</td>
                <td class="d-flex gap-1">
                    {% if can_update %}<form method="post" action="copilot-agents.php"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ client.id }}">{% if client.is_active %}<button class="btn btn-sm btn-outline-secondary" name="disable_agent" value="1">{{ __('Disable', 'uxconnector') }}</button>{% else %}<button class="btn btn-sm btn-outline-success" name="enable_agent" value="1">{{ __('Enable', 'uxconnector') }}</button>{% endif %}</form>{% endif %}
                    {% if can_delete %}<form method="post" action="copilot-agents.php" onsubmit="return confirm('{{ __('Delete this Copilot agent?', 'uxconnector')|e('js') }}')"><input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}"><input type="hidden" name="id" value="{{ client.id }}"><button class="btn btn-sm btn-outline-danger" name="delete_agent" value="1">{{ __('Delete', 'uxconnector') }}</button></form>{% endif %}
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-muted">{{ __('No AI agent configured yet.', 'uxconnector') }}</td></tr>
        {% endfor %}
        </tbody>
    </table></div></div>

    <div class="card mt-4"><div class="card-header"><strong>Copilot Studio</strong></div><div class="card-body">
        <div><strong>OpenAPI:</strong> <code>/plugins/uxconnector/front/copilot-openapi.php</code></div>
        <div class="mt-2"><strong>Authentication header:</strong> <code>X-UXConnector-Copilot-Key</code></div>
        <div class="mt-2"><span class="badge bg-success">{{ __('Lot 2 analytics enabled', 'uxconnector') }}</span></div>
        <div class="mt-2 text-muted">{{ __('The gateway remains read-only in this release.', 'uxconnector') }}</div>
        <div class="mt-3 small">
            <strong>{{ __('Available analytics:', 'uxconnector') }}</strong>
            <code>analyzeTicketVolume</code>, <code>analyzeTicketTrends</code>, <code>analyzeCategories</code>, <code>analyzeSlaPerformance</code>, <code>analyzeGroupPerformance</code>, <code>analyzeTechnicianWorkload</code>, <code>comparePeriods</code>
        </div>
    </div></div>
</div>
