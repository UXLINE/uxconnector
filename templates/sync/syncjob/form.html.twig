{# UXConnector advanced custom interaction editor - GLPI 11 fragment, no extends. #}

<div class="uxconnector-syncjob-form">
    <h2>{{ __('Advanced custom REST interaction', 'uxconnector') }}</h2>

    <div class="alert alert-info mb-3">
        <strong>{{ __('Advanced mode', 'uxconnector') }}</strong> -
        {{ __('Use this editor only for an API that has no ready-to-use interaction in the connection catalog. Jira, Intune, MDM and other standard connectors must normally be configured from the Connection screen.', 'uxconnector') }}
    </div>

    {% if authConfigs|length == 0 %}
        <p class="uxconnector-empty-state">
            {{ __('Create a connection before creating an interaction.', 'uxconnector') }}
        </p>
    {% else %}
        <form method="post" action="syncjob.form.php" id="uxconnector-syncjob-form">
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token }}">

            <h3>{{ __('1. Interaction', 'uxconnector') }}</h3>
            <table class="tab_cadre_fixe">
                <tr class="tab_bg_1">
                    <td><label for="name">{{ __('Name', 'uxconnector') }}</label></td>
                    <td><input type="text" id="name" name="name" required maxlength="128" class="form-control" placeholder="API métier → Tickets GLPI"></td>
                </tr>
                <tr class="tab_bg_1">
                    <td><label for="auth_config_reference">{{ __('Connection', 'uxconnector') }}</label></td>
                    <td>
                        <select id="auth_config_reference" name="auth_config_reference" required class="form-select">
                            {% for authconfig in authConfigs %}
                                <option value="{{ authconfig.id }}" {% if defaults.auth_config_id == authconfig.id %}selected{% endif %}>{{ authconfig.name }} - {{ authconfig.statusLabel }}</option>
                            {% endfor %}
                        </select>
                    </td>
                </tr>
                <tr class="tab_bg_1">
                    <td><label for="interaction_mode">{{ __('Mode', 'uxconnector') }}</label></td>
                    <td>
                        <select id="interaction_mode" name="interaction_mode" required class="form-select">
                            <option value="inbound_polling">{{ __('External system → GLPI - scheduled REST polling', 'uxconnector') }}</option>
                            <option value="inbound_webhook">{{ __('External system → GLPI - incoming webhook/event', 'uxconnector') }}</option>
                            <option value="outbound_glpi_event">{{ __('GLPI → external system - on GLPI object change', 'uxconnector') }}</option>
                        </select>
                        <div class="form-text">{{ __('Bidirectional behavior is configured as two independent interactions.', 'uxconnector') }}</div>
                    </td>
                </tr>
                <tr class="tab_bg_1">
                    <td><label for="target_itemtype">{{ __('GLPI object', 'uxconnector') }}</label></td>
                    <td>
                        <select id="target_itemtype" name="target_itemtype" required class="form-select">
                            {% for itemtype in targetItemtypes %}
                                <option value="{{ itemtype.value }}">{{ itemtype.label() }}</option>
                            {% endfor %}
                        </select>
                    </td>
                </tr>
                <tr class="tab_bg_1">
                    <td><label for="external_object_type">{{ __('External object type', 'uxconnector') }}</label></td>
                    <td><input type="text" id="external_object_type" name="external_object_type" maxlength="64" class="form-control" placeholder="issue / project / device"><div class="form-text">{{ __('Stable technical family used by ObjectLink to share equivalences between inbound and outbound interactions.', 'uxconnector') }}</div></td>
                </tr>
                <tr class="tab_bg_1">
                    <td><label for="match_field">{{ __('GLPI match field', 'uxconnector') }}</label></td>
                    <td><input type="text" id="match_field" name="match_field" required value="name" class="form-control"><div class="form-text">{{ __('Used for inbound first reconciliation. For outbound-only interactions it is retained as technical metadata.', 'uxconnector') }}</div></td>
                </tr>
                <tr class="tab_bg_1">
                    <td><label for="external_id_field">{{ __('External ID JSON path', 'uxconnector') }}</label></td>
                    <td><input type="text" id="external_id_field" name="external_id_field" required value="id" class="form-control"><div class="form-text">{{ __('Inbound: stable external identifier in the received record. Nested paths are supported.', 'uxconnector') }}</div></td>
                </tr>
            </table>

            <details class="card mt-3" open>
                <summary class="card-header"><strong>{{ __('2A. Polling / inbound REST settings', 'uxconnector') }}</strong></summary>
                <div class="card-body">
                    <p class="text-muted">{{ __('Fill this section for scheduled external → GLPI polling. For a webhook or GLPI → external interaction, these values are ignored or neutralized.', 'uxconnector') }}</p>
                    <div class="mb-3"><label class="form-label" for="resource_path">{{ __('Resource path', 'uxconnector') }}</label><input type="text" id="resource_path" name="resource_path" placeholder="/api/resources" class="form-control"></div>
                    <div class="mb-3"><label class="form-label" for="collection_path">{{ __('Collection JSON path', 'uxconnector') }}</label><input type="text" id="collection_path" name="collection_path" value="$" class="form-control" placeholder="$ / value / data.items"><div class="form-text">{{ __('Use $ when the response root is already the record/array.', 'uxconnector') }}</div></div>
                    <div class="mb-3"><label class="form-label" for="pagination_type">{{ __('Pagination strategy', 'uxconnector') }}</label><select id="pagination_type" name="pagination_type" class="form-select"><option value="none">{{ __('None', 'uxconnector') }}</option><option value="offset">{{ __('Offset', 'uxconnector') }}</option><option value="count_offset">{{ __('Offset by page size', 'uxconnector') }}</option><option value="cursor">{{ __('Cursor', 'uxconnector') }}</option><option value="next_link">{{ __('Next link', 'uxconnector') }}</option></select></div>
                    <details>
                        <summary>{{ __('Pagination parameters', 'uxconnector') }}</summary>
                        <table class="tab_cadre_fixe mt-2">
                            <tr class="tab_bg_1"><td>{{ __('Cursor response path', 'uxconnector') }}</td><td><input type="text" name="cursor_response_path" class="form-control" placeholder="nextCursor"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Cursor request parameter', 'uxconnector') }}</td><td><input type="text" name="cursor_request_parameter" class="form-control" placeholder="cursor"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Last-page response path (optional)', 'uxconnector') }}</td><td><input type="text" name="last_page_response_path" class="form-control" placeholder="isLast"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Offset response path', 'uxconnector') }}</td><td><input type="text" name="offset_response_path" class="form-control" placeholder="startAt"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Offset request parameter', 'uxconnector') }}</td><td><input type="text" name="offset_request_parameter" class="form-control" placeholder="startAt"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Page-size response path', 'uxconnector') }}</td><td><input type="text" name="page_size_response_path" class="form-control" placeholder="maxResults"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Fixed page size (count-offset)', 'uxconnector') }}</td><td><input type="number" min="1" name="page_size" class="form-control" placeholder="100"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Total response path', 'uxconnector') }}</td><td><input type="text" name="total_response_path" class="form-control" placeholder="total"></td></tr>
                            <tr class="tab_bg_1"><td>{{ __('Next-link response path', 'uxconnector') }}</td><td><input type="text" name="next_link_response_path" class="form-control" placeholder="$['@odata.nextLink']"></td></tr>
                        </table>
                    </details>
                </div>
            </details>

            <details class="card mt-3" open>
                <summary class="card-header"><strong>{{ __('2B. External → GLPI field mappings', 'uxconnector') }}</strong></summary>
                <div class="card-body">
                    <p class="form-text">{{ __('Used by polling and webhook interactions. Source fields accept nested JSON paths and constants such as @literal:1. Transform accepts named transforms or map:key=value|key=value.', 'uxconnector') }}</p>
                    <p class="form-text">Fields : utilisez le champ cible <code>fields:Libellé exact</code> figurant dans la liste ci-dessous. Les blocs doivent déjà exister et être actifs. Pour un lien SIM vers une ligne déjà importée : transformation <code>link:glpi_rest_v1_location_telecom_line</code> sur le champ cible <code>lines_id</code> ; la source doit être l’ID du pseudo-lieu GLPI 10 et la connexion identique à celle de l’import initial. Les ID numériques directs doivent être des ID GLPI 11 vérifiés, jamais des ID GLPI 10.</p>
                    <datalist id="uxconnector-transform-list"><option value="trim"></option><option value="uppercase"></option><option value="lowercase"></option><option value="date_iso8601"></option><option value="datetime_glpi"></option><option value="integer"></option><option value="boolean_int"></option></datalist>
                    <table class="tab_cadre_fixe" id="uxconnector-field-mappings">
                        <thead><tr><th>{{ __('Source field / JSON path', 'uxconnector') }}</th><th>{{ __('Target field', 'uxconnector') }}</th><th>{{ __('Transform / value map', 'uxconnector') }}</th><th>{{ __('Required', 'uxconnector') }}</th></tr></thead>
                        <tbody>{% for i in 0..9 %}<tr class="tab_bg_1"><td><input type="text" name="source_field[]" class="form-control"></td><td><input type="text" name="target_field[]" class="form-control"></td><td><input type="text" name="transform[]" list="uxconnector-transform-list" class="form-control"></td><td><input type="checkbox" name="required[{{ i }}]" value="1"></td></tr>{% endfor %}</tbody>
                    </table>
                    <details class="mt-3"><summary>{{ __('Allowed GLPI target fields', 'uxconnector') }}</summary><ul>{% for entry in targetFieldCatalog %}<li><strong>{{ entry.label }}</strong> - {{ __('match fields', 'uxconnector') }}: <code>{{ entry.matchable|join(', ') }}</code><br>{{ __('writable fields', 'uxconnector') }}: <code>{{ entry.writable|join(', ') }}</code></li>{% endfor %}</ul></details>
                </div>
            </details>

            <details class="card mt-3">
                <summary class="card-header"><strong>{{ __('2C. GLPI → external REST settings', 'uxconnector') }}</strong></summary>
                <div class="card-body">
                    <p class="text-muted">{{ __('Fill this section only for GLPI → external interactions. At least a create or update request must be defined.', 'uxconnector') }}</p>
                    <div class="row g-3">
                        <div class="col-md-2"><label class="form-label">{{ __('Create method', 'uxconnector') }}</label><select name="outbound_create_method" class="form-select"><option value=""></option><option>POST</option><option>PUT</option><option>PATCH</option></select></div>
                        <div class="col-md-10"><label class="form-label">{{ __('Create path', 'uxconnector') }}</label><input name="outbound_create_path" class="form-control" placeholder="/api/projects"></div>
                        <div class="col-12"><label class="form-label">{{ __('Create JSON body definition', 'uxconnector') }}</label><textarea name="outbound_create_body" rows="5" class="form-control" placeholder='{"name":"@field:name","description":"@field_optional:content"}'></textarea></div>
                        <div class="col-md-2"><label class="form-label">{{ __('Update method', 'uxconnector') }}</label><select name="outbound_update_method" class="form-select"><option value=""></option><option>PUT</option><option>PATCH</option><option>POST</option><option>DELETE</option></select></div>
                        <div class="col-md-10"><label class="form-label">{{ __('Update path', 'uxconnector') }}</label><input name="outbound_update_path" class="form-control" placeholder="/api/projects/{{external_id}}"></div>
                        <div class="col-12"><label class="form-label">{{ __('Update JSON body definition', 'uxconnector') }}</label><textarea name="outbound_update_body" rows="5" class="form-control" placeholder='{"name":"@field:name"}'></textarea></div>
                        <div class="col-md-6"><label class="form-label">{{ __('Create response external ID JSON path', 'uxconnector') }}</label><input name="outbound_response_external_id_path" class="form-control" value="id"></div>
                    </div>
                    <div class="form-text mt-2"><code>@field:name</code> {{ __('requires a GLPI field', 'uxconnector') }} · <code>@field_optional:content</code> {{ __('allows a missing field', 'uxconnector') }} · <code>{{ '{{external_id}}' }}</code> {{ __('uses the ObjectLink external identifier in an update path.', 'uxconnector') }}</div>
                </div>
            </details>

            <details class="card mt-3" open>
                <summary class="card-header"><strong>{{ __('3. Entity / source scope', 'uxconnector') }}</strong></summary>
                <div class="card-body">
                    <table class="tab_cadre_fixe">
                        <tr class="tab_bg_1"><td><label for="entity_strategy">{{ __('Strategy', 'uxconnector') }}</label></td><td><select id="entity_strategy" name="entity_strategy" class="form-select"><option value="">{{ __('None - leave to GLPI default', 'uxconnector') }}</option><option value="fixed">{{ __('Fixed - inbound target entity / outbound source scope', 'uxconnector') }}</option><option value="mapped">{{ __('Mapped from a source field - inbound only', 'uxconnector') }}</option></select></td></tr>
                        <tr class="tab_bg_1"><td><label for="entity_fixed_id">{{ __('Fixed entity ID', 'uxconnector') }}</label></td><td><input type="number" id="entity_fixed_id" name="entity_fixed_id" min="0" class="form-control"></td></tr>
                        <tr class="tab_bg_1"><td><label for="entity_source_field">{{ __('Source field (mapped)', 'uxconnector') }}</label></td><td><input type="text" id="entity_source_field" name="entity_source_field" class="form-control"></td></tr>
                        <tr class="tab_bg_1"><td><label for="entity_mapping_rules">{{ __('Mapping rules (mapped)', 'uxconnector') }}</label></td><td><textarea id="entity_mapping_rules" name="entity_mapping_rules" rows="4" class="form-control" placeholder="A=0&#10;B=2"></textarea></td></tr>
                        <tr class="tab_bg_1"><td><label for="entity_unknown_policy">{{ __('Unknown source value', 'uxconnector') }}</label></td><td><select id="entity_unknown_policy" name="entity_unknown_policy" class="form-select"><option value="fail">{{ __('Fail this record', 'uxconnector') }}</option><option value="use_default">{{ __('Use a default entity', 'uxconnector') }}</option></select></td></tr>
                        <tr class="tab_bg_1"><td><label for="entity_default_id">{{ __('Default entity ID', 'uxconnector') }}</label></td><td><input type="number" id="entity_default_id" name="entity_default_id" min="0" class="form-control"></td></tr>
                    </table>
                </div>
            </details>

        {% include '@uxconnector/sync/syncjob/schedule.html.twig' %}
            <div class="uxconnector-form-actions mt-3"><button type="submit" name="add" class="btn btn-primary">{{ __('Create interaction', 'uxconnector') }}</button></div>
        </form>
    {% endif %}
</div>
