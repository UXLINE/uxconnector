{
  "id": "glpi-hl",
  "version": "2.17.1",
  "name": "GLPI 11 High-Level API",
  "description": "Lecture d'un GLPI 11 distant via l'API High-Level et consolidation de son parc. Les assets sont réconciliés par ObjectLink puis enrichis automatiquement avec entité, statut, fabricant, lieu, type et modèle à partir des noms renvoyés par l'API source.",
  "icon": "ti ti-brand-tabler",
  "endpoint_hint": "https://glpi.example.tld",
  "test_path_hint": "/api.php/Assets/Computer?start=0&limit=1",
  "auth_methods": [
    "oauth2_password"
  ],
  "jobs": [
    {
      "id": "glpi-hl.assets.computers.inbound",
      "version": "2.17.1",
      "name": "1 - GLPI source → Ordinateurs",
      "description": "Lit les ordinateurs du GLPI distant et les crée/met à jour dans le GLPI de consolidation. Réconciliation initiale par UUID, puis numéro de série, numéro d'inventaire et enfin nom ; les relectures utilisent ObjectLink. Référentiels GLPI (entité, statut, fabricant, lieu, type et modèle) résolus/créés automatiquement puis rattachés à l'actif.",
      "direction": "inbound",
      "resource_path": "/api.php/Assets/Computer?start=0&limit={{page_size}}",
      "collection_path": "$",
      "pagination": {
        "type": "count_offset",
        "options": {
          "offset_request_parameter": "start",
          "page_size": "{{page_size}}"
        }
      },
      "target_itemtype": "computer",
      "match_field": "asset_identity",
      "external_id_field": "id",
      "external_object_type": "glpi_hl_computer",
      "field_mappings": [
        {
          "source": "name",
          "target": "name",
          "required": false
        },
        {
          "source": "serial",
          "target": "serial",
          "required": false
        },
        {
          "source": "otherserial",
          "target": "otherserial",
          "required": false
        },
        {
          "source": "uuid",
          "target": "uuid",
          "required": false
        },
        {
          "source": "comment",
          "target": "comment",
          "required": false
        },
        {
          "source": "contact",
          "target": "contact",
          "required": false
        },
        {
          "source": "contact_num",
          "target": "contact_num",
          "required": false
        }
      ],
      "parameters": [
        {
          "name": "page_size",
          "label": "Taille de page API",
          "required": true,
          "default": "100",
          "description": "Nombre d'ordinateurs lus par appel High-Level API. 100 est recommandé pour le premier atelier."
        }
      ]
    },
    {
