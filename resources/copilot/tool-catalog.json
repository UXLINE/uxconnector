        },
        {
            "id": "analyzeTicketTrends",
            "method": "POST",
            "path": "/plugins/uxconnector/front/copilot-ticket-trends.php",
            "description": "Analyze ticket trends by day, week or month."
        },
        {
            "id": "analyzeCategories",
            "method": "POST",
            "path": "/plugins/uxconnector/front/copilot-categories.php",
            "description": "Rank ITIL categories and compare their volumes and resolution time."
        },
        {
            "id": "analyzeSlaPerformance",
            "method": "POST",
            "path": "/plugins/uxconnector/front/copilot-sla.php",
            "description": "Analyze TTO/TTR compliance where GLPI deadlines are evaluable."
        },
        {
            "id": "analyzeSlaBreaches",
            "method": "POST",
